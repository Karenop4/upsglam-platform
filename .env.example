# ==============================================================================
# Capa: Infrastructure (Configuration Template)
# Responsabilidad: Plantilla de variables de entorno (URLs de Supabase, JWKS /
#   JWT secret, PostgREST, Storage, límites de GPU y puertos) sin credenciales
#   reales.
# Regla de Dependencia: Archivo de configuración externa inyectado en tiempo de
#   ejecución a la capa de Infrastructure de cada servicio. Prohibido almacenar
#   secretos reales o contraseñas directas de PostgreSQL en el repositorio.
# ==============================================================================

# Puertos de Servicios
GATEWAY_PORT=8080
MS_SOCIAL_PORT=8081
MS_PROCESSING_PORT=8082
MS_GPU_PYCUDA_PORT=8000

# Configuración de Supabase (Auth JWKS, PostgREST REST API, Storage, Realtime)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_REST_URL=https://your-project-ref.supabase.co/rest/v1
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-fallback-placeholder
SUPABASE_STORAGE_BUCKET=upsglam-images

# Límites y Concurrencia GPU (PyCUDA)
GPU_DEVICE_INDEX=0
GPU_MAX_CONCURRENT_TASKS=4
GPU_QUEUE_MAX_SIZE=16
GPU_TASK_TIMEOUT_SECONDS=15
GPU_MAX_IMAGE_WIDTH=4096
GPU_MAX_IMAGE_HEIGHT=4096
GPU_TEMP_RESULT_TTL_SECONDS=300
